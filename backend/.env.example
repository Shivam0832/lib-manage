PORT=4000
# Required in production (the server refuses to start without a strong one).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=7d
# NODE_ENV=production

# Loan policy
LOAN_DAYS=14
FINE_PER_DAY=5

# Failed login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20

# Optional: only if the UI is hosted on a different origin (comma-separated)
CORS_ORIGIN=
# Optional: where the SQLite file lives (e.g. a mounted disk on Render)
# DB_PATH=/var/data/library.db
